# Placeholder values: never put a real key here or in the app code.
# The InferHub key lives only in the backend environment (worker/).
INFERHUB_API_KEY=sk-inferhub-REPLACE-WITH-A-FAKE-VALUE

# InferHub router: model and endpoint (the local router injects its own key).
INFERHUB_MODEL=combo/cheap
INFERHUB_BASE_URL=http://127.0.0.1:18100/v1

# Public backend URL, app side (public Expo environment variable name).
EXPO_PUBLIC_VERSO_API_URL=http://localhost:8787
